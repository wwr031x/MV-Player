# ==============================================
# MV Player 环境变量示例
# 复制此文件为 .env.local 并按需填写
# ==============================================

# ---- 基础配置 ----

# 应用部署的 base path（部署在子路径时修改，如 /app/mv-player/）
CLIENT_BASE_PATH=/

# ---- 一起听功能配置 ----

# Supabase 项目 URL（一起听功能使用 Supabase Realtime 时需要）
# 注册地址：https://supabase.com/ 或自建
VITE_SUPABASE_URL=

# Supabase anon public key（与上面的 URL 对应）
# 注意：anon key 设计上是公开的，但建议不要泄露你的项目 URL 和 key 组合
VITE_SUPABASE_ANON_KEY=

# 自建 WebSocket 一起听服务地址（如不使用 Supabase 时配置）
# 示例：wss://your-domain.com/ws
VITE_LISTEN_TOGETHER_WS_URL=

# ---- 网易云音乐 API 配置 ----

# 网易云音乐 API 基础地址
# 推荐自行部署：https://github.com/Binaryify/NeteaseCloudMusicApi
# 也可使用公开实例（不保证稳定性，仅供测试）
# 示例：https://your-netease-api.example.com
VITE_NETEASE_API_BASE=

# ---- 开发代理配置（仅开发环境） ----

# 本地一起听 WebSocket 服务端口（默认 8089）
# WS_PROXY_PORT=8089

# 本地网易云 API 服务端口（默认 8090）
# NETEASE_API_PORT=8090
